# ─── Gitaarth AI — Environment Variables ───
# Copy this file to .env and fill in your values

# xAI Grok API Key (get from https://console.x.ai/)
XAI_GROK_API_KEY=your_grok_api_key_here

# Grok Model (default: grok-3-latest)
XAI_GROK_MODEL=grok-3-latest

# Server Port
PORT=5000

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# MongoDB Connection String (optional — for Phase 4+)
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/gitaarth?retryWrites=true&w=majority
